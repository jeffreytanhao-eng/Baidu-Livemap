[Unit]
Description=Livemap FastAPI (uvicorn 8000)
After=network.target

[Service]
WorkingDirectory=/opt/livemap/apps/api
EnvironmentFile=/opt/livemap/.env
ExecStart=/opt/livemap/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
